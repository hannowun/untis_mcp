# Copy to .env, then adjust:  cp .env.example .env && chmod 600 .env
#
# This file decides what the Raspberry Pi exposes to the network, and it may hold the
# bearer token and profile passwords, so it is git-ignored and never enters an image.
# scripts/deploy.sh refuses to run without it and checks the values below.
#
# Every variable here is also passed into the container.

# --- what is reachable from outside ---------------------------------------------------

# The host interface the port is published on. This is the entire access control story:
# the server authorizes nobody, so whatever can reach the port reads every profile.
#
#   127.0.0.1     loopback only — reachable from the Pi itself, and over an SSH tunnel
#   192.168.x.y   one address of the Pi; `ip -4 -o addr` lists what this machine has
#   0.0.0.0       every interface, including ones you did not think about
#
# deploy.sh rejects an address this machine does not have, and warns when the choice is
# wider than the loopback and no auth token is set.
UNTIS_MCP_BIND=127.0.0.1

# The host port MCP clients connect to: http://<UNTIS_MCP_BIND>:<port>/mcp
UNTIS_MCP_EXPOSED_PORT=8000

# The port the server listens on inside the container. Rarely worth changing — the
# published port above is the one that faces the network.
UNTIS_MCP_PORT=8000

# --- image ----------------------------------------------------------------------------

# What `docker compose up` runs. Matches the tag built by scripts/build.ps1, or the
# registry reference when the image is pulled.
UNTIS_MCP_IMAGE=untis-mcp:latest

# --- runtime --------------------------------------------------------------------------

# The timezone school days are interpreted in. Wrong here means the right data for the
# wrong day.
TZ=Europe/Berlin

# DEBUG | INFO | WARNING | ERROR
UNTIS_MCP_LOG_LEVEL=INFO

# A static bearer token clients must present (ADR-006). Empty means no token, which is
# only defensible while UNTIS_MCP_BIND is the loopback.
UNTIS_MCP_AUTH_TOKEN=

# --- profile passwords ----------------------------------------------------------------

# A profile in config/profiles.toml can name an environment variable instead of holding
# its password inline:
#
#   password_env = "UNTIS_EMIL_PASSWORD"
#
# Put that variable here; deploy.sh checks that every password_env a profile names has a
# value in this file.
# UNTIS_EMIL_PASSWORD=
